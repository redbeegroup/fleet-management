// Fleet Management System — core schema (Phase 1 / Sprint 1-2)
// Every tenant-owned table carries company_id and is protected by PostgreSQL RLS
// (see migrations/*_rls_and_telemetry/migration.sql).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  OPERATING
  UNDER_REPAIR
  INACTIVE
  DISPOSED
}

enum VehicleClass {
  TRUCK
  VAN
  CAR
  PICKUP
  BUS
  MOTORCYCLE
  TRAILER
  THREE_WHEELER
  TRACTOR
  MACHINERY
  OTHER
}

enum OwnershipType {
  OWNED
  LEASED
  RENTED
  CONTRACTOR
}

enum DocumentType {
  REGISTRATION
  INSURANCE
  ROAD_TAX
  PERMIT
  INSPECTION
  OTHER
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  timezone  String   @default("Asia/Yangon")
  currency  String   @default("MMK")
  /// Company-level settings (telematics thresholds…), validated by the API with defaults.
  settings  Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches    Branch[]
  departments Department[]
  users       User[]
  vehicles    Vehicle[]
  drivers     Driver[]

  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id])
  vehicles Vehicle[]
  drivers  Driver[]
  users    User[]

  @@unique([companyId, code])
  @@map("branches")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id])
  vehicles Vehicle[]

  @@unique([companyId, code])
  @@map("departments")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  branchId     String?   @map("branch_id") @db.Uuid
  email        String    @unique
  fullName     String    @map("full_name")
  passwordHash String    @map("password_hash")
  roles        String[]
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  refreshTokens RefreshToken[]
  driver        Driver?
  notifications Notification[]
  devices       UserDevice[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  companyId  String?  @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  method     String?
  path       String?
  statusCode Int?     @map("status_code")
  ip         String?
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Vehicle {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  branchId      String?       @map("branch_id") @db.Uuid
  departmentId  String?       @map("department_id") @db.Uuid
  plateNumber   String        @map("plate_number")
  vin           String?
  make          String
  model         String
  year          Int?
  vehicleClass  VehicleClass  @map("vehicle_class")
  ownership     OwnershipType @default(OWNED)
  fuelType      String?       @map("fuel_type")
  capacityKg    Decimal?      @map("capacity_kg") @db.Decimal(12, 2)
  capacityM3    Decimal?      @map("capacity_m3") @db.Decimal(12, 2)
  odometerKm    Decimal       @default(0) @map("odometer_km") @db.Decimal(12, 1)
  status        VehicleStatus @default(AVAILABLE)
  gpsDeviceId   String?       @map("gps_device_id")
  /// Overrides the company speed limit for overspeed alerts.
  speedLimitKmh Int?          @map("speed_limit_kmh")
  /// Fuel tank capacity (litres), used to flag implausible refills.
  tankCapacityL Decimal?      @map("tank_capacity_l") @db.Decimal(8, 1)
  acquiredAt    DateTime?     @map("acquired_at") @db.Date
  disposedAt    DateTime?     @map("disposed_at") @db.Date
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  company         Company              @relation(fields: [companyId], references: [id])
  branch          Branch?              @relation(fields: [branchId], references: [id])
  department      Department?          @relation(fields: [departmentId], references: [id])
  documents       VehicleDocument[]
  assignments     VehicleAssignment[]
  statusHistory   VehicleStatusEvent[]
  Trip            Trip[]
  FuelRecord      FuelRecord[]
  MaintenancePlan MaintenancePlan[]
  RepairRequest   RepairRequest[]
  WorkOrder       WorkOrder[]
  expenses        VehicleExpense[]

  @@unique([companyId, plateNumber])
  @@unique([companyId, gpsDeviceId])
  @@index([companyId, status])
  @@map("vehicles")
}

model VehicleStatusEvent {
  id         String         @id @default(uuid()) @db.Uuid
  companyId  String         @map("company_id") @db.Uuid
  vehicleId  String         @map("vehicle_id") @db.Uuid
  fromStatus VehicleStatus? @map("from_status")
  toStatus   VehicleStatus  @map("to_status")
  reason     String?
  userId     String?        @map("user_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, createdAt])
  @@map("vehicle_status_events")
}

model VehicleDocument {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  vehicleId String       @map("vehicle_id") @db.Uuid
  type      DocumentType
  number    String?
  issuer    String?
  issuedAt  DateTime?    @map("issued_at") @db.Date
  expiresAt DateTime?    @map("expires_at") @db.Date
  amount    Decimal?     @db.Decimal(14, 2)
  fileId    String?      @map("file_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  file    StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([companyId, expiresAt])
  @@map("vehicle_documents")
}

model VehicleAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  vehicleId    String    @map("vehicle_id") @db.Uuid
  driverId     String?   @map("driver_id") @db.Uuid
  branchId     String?   @map("branch_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  note         String?
  startAt      DateTime  @default(now()) @map("start_at")
  endAt        DateTime? @map("end_at")
  createdBy    String?   @map("created_by") @db.Uuid

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver? @relation(fields: [driverId], references: [id])

  @@index([vehicleId, endAt])
  @@index([driverId, endAt])
  @@map("vehicle_assignments")
}

model Driver {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  userId     String?  @unique @map("user_id") @db.Uuid
  employeeNo String   @map("employee_no")
  fullName   String   @map("full_name")
  phone      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company     Company             @relation(fields: [companyId], references: [id])
  branch      Branch?             @relation(fields: [branchId], references: [id])
  user        User?               @relation(fields: [userId], references: [id])
  licenses    DriverLicense[]
  assignments VehicleAssignment[]
  trips       Trip[]
  duty        DutySession[]
  fuelRecords FuelRecord[]

  @@unique([companyId, employeeNo])
  @@map("drivers")
}

model DriverLicense {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  driverId     String    @map("driver_id") @db.Uuid
  number       String
  licenseClass String    @map("license_class")
  issuedAt     DateTime? @map("issued_at") @db.Date
  expiresAt    DateTime? @map("expires_at") @db.Date
  fileId       String?   @map("file_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  driver Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  file   StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([companyId, expiresAt])
  @@map("driver_licenses")
}

model VehicleLastPosition {
  vehicleId  String   @id @map("vehicle_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  recordedAt DateTime @map("recorded_at")
  latitude   Float
  longitude  Float
  speedKmh   Float?   @map("speed_kmh")
  heading    Float?
  ignition   Boolean?
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("vehicle_last_positions")
}

/// Binary objects (documents, photos, signatures). Content lives in the
/// configured storage driver (local filesystem or S3-compatible); access is
/// always streamed through the API so tenant checks apply.
model StoredFile {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  storageKey  String   @unique @map("storage_key")
  filename    String
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  sha256      String
  uploadedBy  String?  @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  vehicleDocuments VehicleDocument[]
  driverLicenses   DriverLicense[]

  @@index([companyId, createdAt])
  @@map("files")
}

/// In-app notification for one user. `dedupeKey` prevents repeated alerts
/// for the same event/threshold.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  topic     String
  severity  String    @default("info")
  title     String
  body      String
  data      Json?
  dedupeKey String?   @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  emailedAt DateTime? @map("emailed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

enum GeofenceShape {
  CIRCLE
  POLYGON
}

enum TelemetryEventType {
  GEOFENCE_ENTER
  GEOFENCE_EXIT
  OVERSPEED
  IDLE
  IGNITION_ON
  IGNITION_OFF
  GPS_OFFLINE
  GPS_RESTORED
}

/// Virtual boundary: branch, warehouse, customer site, restricted area…
model Geofence {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  name         String
  category     String        @default("SITE")
  shape        GeofenceShape
  /// CIRCLE: centre + radius
  centerLat    Float?        @map("center_lat")
  centerLng    Float?        @map("center_lng")
  radiusM      Float?        @map("radius_m")
  /// POLYGON: [[lng, lat], ...] (GeoJSON order, not closed)
  polygon      Json?
  alertOnEnter Boolean       @default(false) @map("alert_on_enter")
  alertOnExit  Boolean       @default(false) @map("alert_on_exit")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([companyId, active])
  @@map("geofences")
}

/// Detected telematics events (append-only; durations filled when an episode ends).
model TelemetryEvent {
  id         String             @id @default(uuid()) @db.Uuid
  companyId  String             @map("company_id") @db.Uuid
  vehicleId  String             @map("vehicle_id") @db.Uuid
  type       TelemetryEventType
  occurredAt DateTime           @map("occurred_at")
  endedAt    DateTime?          @map("ended_at")
  latitude   Float?
  longitude  Float?
  speedKmh   Float?             @map("speed_kmh")
  geofenceId String?            @map("geofence_id") @db.Uuid
  data       Json?
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([companyId, occurredAt])
  @@index([vehicleId, occurredAt])
  @@map("telemetry_events")
}

/// Per-vehicle rules-engine state carried between ingest batches.
model VehicleTelemetryState {
  vehicleId         String    @id @map("vehicle_id") @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  lastFixAt         DateTime? @map("last_fix_at")
  ignition          Boolean?
  insideGeofenceIds String[]  @map("inside_geofence_ids")
  overspeedEventId  String?   @map("overspeed_event_id") @db.Uuid
  overspeedMaxKmh   Float?    @map("overspeed_max_kmh")
  idleSince         DateTime? @map("idle_since")
  idleEventId       String?   @map("idle_event_id") @db.Uuid
  offlineEventId    String?   @map("offline_event_id") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("vehicle_telemetry_state")
}

enum TripStatus {
  PLANNED
  ASSIGNED
  ONGOING
  COMPLETED
  CANCELLED
}

/// Per-company sequence numbers (trip numbers, work orders…).
model CompanyCounter {
  companyId String @map("company_id") @db.Uuid
  key       String
  value     Int    @default(0)

  @@id([companyId, key])
  @@map("company_counters")
}

/// A transport task: one vehicle + driver from origin to destination.
model Trip {
  id               String     @id @default(uuid()) @db.Uuid
  companyId        String     @map("company_id") @db.Uuid
  tripNo           String     @map("trip_no")
  branchId         String?    @map("branch_id") @db.Uuid
  vehicleId        String?    @map("vehicle_id") @db.Uuid
  driverId         String?    @map("driver_id") @db.Uuid
  status           TripStatus @default(PLANNED)
  purpose          String?
  originName       String     @map("origin_name")
  originLat        Float?     @map("origin_lat")
  originLng        Float?     @map("origin_lng")
  destinationName  String     @map("destination_name")
  destinationLat   Float?     @map("destination_lat")
  destinationLng   Float?     @map("destination_lng")
  plannedStart     DateTime   @map("planned_start")
  plannedEnd       DateTime   @map("planned_end")
  actualStart      DateTime?  @map("actual_start")
  actualEnd        DateTime?  @map("actual_end")
  startOdometerKm  Decimal?   @map("start_odometer_km") @db.Decimal(12, 1)
  endOdometerKm    Decimal?   @map("end_odometer_km") @db.Decimal(12, 1)
  gpsDistanceKm    Decimal?   @map("gps_distance_km") @db.Decimal(10, 1)
  cargoDescription String?    @map("cargo_description")
  cargoWeightKg    Decimal?   @map("cargo_weight_kg") @db.Decimal(12, 2)
  notes            String?
  cancelReason     String?    @map("cancel_reason")
  createdBy        String?    @map("created_by") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  vehicle       Vehicle?          @relation(fields: [vehicleId], references: [id])
  driver        Driver?           @relation(fields: [driverId], references: [id])
  statusHistory TripStatusEvent[]

  @@unique([companyId, tripNo])
  @@index([companyId, plannedStart])
  @@index([vehicleId, plannedStart])
  @@index([driverId, plannedStart])
  @@index([companyId, status])
  @@map("trips")
}

model TripStatusEvent {
  id         String      @id @default(uuid()) @db.Uuid
  companyId  String      @map("company_id") @db.Uuid
  tripId     String      @map("trip_id") @db.Uuid
  fromStatus TripStatus? @map("from_status")
  toStatus   TripStatus  @map("to_status")
  note       String?
  userId     String?     @map("user_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
  @@map("trip_status_events")
}

/// Driver on-duty session (attendance). endedAt null = currently on duty.
model DutySession {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  driverId  String    @map("driver_id") @db.Uuid
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")
  source    String    @default("web")
  createdBy String?   @map("created_by") @db.Uuid

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, startedAt])
  @@index([companyId, startedAt])
  @@map("duty_sessions")
}

// ---------------------------------------------------------------------------
// Fuel (Sprint 5)
// ---------------------------------------------------------------------------

model FuelRecord {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  vehicleId     String   @map("vehicle_id") @db.Uuid
  driverId      String?  @map("driver_id") @db.Uuid
  filledAt      DateTime @map("filled_at")
  odometerKm    Decimal  @map("odometer_km") @db.Decimal(12, 1)
  litres        Decimal  @db.Decimal(10, 2)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalCost     Decimal  @map("total_cost") @db.Decimal(14, 2)
  fuelType      String?  @map("fuel_type")
  station       String?
  fullTank      Boolean  @default(true) @map("full_tank")
  paymentMethod String?  @map("payment_method")
  receiptFileId String?  @map("receipt_file_id") @db.Uuid
  notes         String?
  source        String   @default("web")
  /// Computed (full-to-full): distance since previous full fill and efficiency.
  distanceKm    Decimal? @map("distance_km") @db.Decimal(10, 1)
  kmPerLitre    Decimal? @map("km_per_litre") @db.Decimal(8, 2)
  /// Anomaly flags, e.g. ["ODOMETER_BACKWARDS", "OVER_TANK_CAPACITY", "LOW_EFFICIENCY"]
  flags         String[] @default([])
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver? @relation(fields: [driverId], references: [id])

  @@index([vehicleId, filledAt])
  @@index([companyId, filledAt])
  @@map("fuel_records")
}

// ---------------------------------------------------------------------------
// Maintenance (Sprint 5)
// ---------------------------------------------------------------------------

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkOrderType {
  PREVENTIVE
  CORRECTIVE
  ACCIDENT
  INSPECTION
}

enum RepairRequestStatus {
  OPEN
  CONVERTED
  REJECTED
}

/// Preventive maintenance schedule for one vehicle (by distance and/or time).
model MaintenancePlan {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  vehicleId          String    @map("vehicle_id") @db.Uuid
  name               String
  intervalKm         Int?      @map("interval_km")
  intervalDays       Int?      @map("interval_days")
  lastDoneAt         DateTime? @map("last_done_at")
  lastDoneOdometerKm Decimal?  @map("last_done_odometer_km") @db.Decimal(12, 1)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  vehicle    Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]

  @@index([companyId, active])
  @@index([vehicleId])
  @@map("maintenance_plans")
}

model RepairRequest {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @map("company_id") @db.Uuid
  vehicleId   String              @map("vehicle_id") @db.Uuid
  reportedBy  String?             @map("reported_by") @db.Uuid
  description String
  severity    String              @default("MEDIUM")
  odometerKm  Decimal?            @map("odometer_km") @db.Decimal(12, 1)
  photoFileId String?             @map("photo_file_id") @db.Uuid
  status      RepairRequestStatus @default(OPEN)
  resolution  String?
  workOrderId String?             @map("work_order_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([companyId, status])
  @@map("repair_requests")
}

model WorkOrder {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  woNo        String          @map("wo_no")
  vehicleId   String          @map("vehicle_id") @db.Uuid
  planId      String?         @map("plan_id") @db.Uuid
  type        WorkOrderType
  status      WorkOrderStatus @default(OPEN)
  priority    String          @default("MEDIUM")
  title       String
  description String?
  workshop    String?
  assignedTo  String?         @map("assigned_to")
  /// When true the vehicle is UNDER_REPAIR while the work order is in progress.
  offRoad     Boolean         @default(true) @map("off_road")
  odometerKm  Decimal?        @map("odometer_km") @db.Decimal(12, 1)
  openedAt    DateTime        @default(now()) @map("opened_at")
  startedAt   DateTime?       @map("started_at")
  completedAt DateTime?       @map("completed_at")
  resolution  String?
  totalCost   Decimal         @default(0) @map("total_cost") @db.Decimal(14, 2)
  createdBy   String?         @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  vehicle        Vehicle          @relation(fields: [vehicleId], references: [id])
  plan           MaintenancePlan? @relation(fields: [planId], references: [id])
  lines          WorkOrderLine[]
  repairRequests RepairRequest[]

  @@unique([companyId, woNo])
  @@index([companyId, status])
  @@index([vehicleId, openedAt])
  @@map("work_orders")
}

model WorkOrderLine {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  kind        String
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitCost    Decimal  @map("unit_cost") @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("work_order_lines")
}

// ---------------------------------------------------------------------------
// Costs, analytics, devices (Sprint 6)
// ---------------------------------------------------------------------------

/// Operating expenses other than fuel and maintenance (tolls, parking, fines…).
model VehicleExpense {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  vehicleId     String   @map("vehicle_id") @db.Uuid
  tripId        String?  @map("trip_id") @db.Uuid
  category      String
  incurredAt    DateTime @map("incurred_at")
  amount        Decimal  @db.Decimal(14, 2)
  description   String?
  receiptFileId String?  @map("receipt_file_id") @db.Uuid
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([companyId, incurredAt])
  @@index([vehicleId, incurredAt])
  @@map("vehicle_expenses")
}

/// Per vehicle per company-local day, rolled up from GPS positions by the worker.
model VehicleDailyStat {
  vehicleId     String   @map("vehicle_id") @db.Uuid
  day           DateTime @db.Date
  companyId     String   @map("company_id") @db.Uuid
  distanceKm    Decimal  @default(0) @map("distance_km") @db.Decimal(10, 2)
  engineMinutes Int      @default(0) @map("engine_minutes")
  movingMinutes Int      @default(0) @map("moving_minutes")
  idleMinutes   Int      @default(0) @map("idle_minutes")
  maxSpeedKmh   Float?   @map("max_speed_kmh")
  positions     Int      @default(0)
  computedAt    DateTime @default(now()) @map("computed_at")

  @@id([vehicleId, day])
  @@index([companyId, day])
  @@map("vehicle_daily_stats")
}

/// Mobile push tokens (Expo) per user.
model UserDevice {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  pushToken  String   @unique @map("push_token")
  platform   String
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_devices")
}
