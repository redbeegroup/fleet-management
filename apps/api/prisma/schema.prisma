// Fleet Management System — core schema (Phase 1 / Sprint 1-2)
// Every tenant-owned table carries company_id and is protected by PostgreSQL RLS
// (see migrations/*_rls_and_telemetry/migration.sql).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  OPERATING
  UNDER_REPAIR
  INACTIVE
  DISPOSED
}

enum VehicleClass {
  TRUCK
  VAN
  CAR
  PICKUP
  BUS
  MOTORCYCLE
  TRAILER
  THREE_WHEELER
  TRACTOR
  MACHINERY
  OTHER
}

enum OwnershipType {
  OWNED
  LEASED
  RENTED
  CONTRACTOR
}

enum DocumentType {
  REGISTRATION
  INSURANCE
  ROAD_TAX
  PERMIT
  INSPECTION
  OTHER
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  timezone  String   @default("Asia/Yangon")
  currency  String   @default("MMK")
  /// Company-level settings (telematics thresholds…), validated by the API with defaults.
  settings  Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches    Branch[]
  departments Department[]
  users       User[]
  vehicles    Vehicle[]
  drivers     Driver[]

  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id])
  vehicles Vehicle[]
  drivers  Driver[]
  users    User[]

  @@unique([companyId, code])
  @@map("branches")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id])
  vehicles Vehicle[]

  @@unique([companyId, code])
  @@map("departments")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  branchId      String?   @map("branch_id") @db.Uuid
  email         String    @unique
  fullName      String    @map("full_name")
  passwordHash  String    @map("password_hash")
  roles         String[]
  active        Boolean   @default(true)
  lastLoginAt   DateTime? @map("last_login_at")
  /// Invited by email and not yet set a password (S14).
  invitedAt     DateTime? @map("invited_at")
  passwordSetAt DateTime? @map("password_set_at")
  /// Single sign-on (S15): issuer + subject of the linked identity, pinned on first SSO sign-in.
  ssoSubject    String?   @unique @map("sso_subject")
  ssoLinkedAt   DateTime? @map("sso_linked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  refreshTokens RefreshToken[]
  driver        Driver?
  notifications Notification[]
  devices       UserDevice[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  companyId  String?  @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  method     String?
  path       String?
  statusCode Int?     @map("status_code")
  ip         String?
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Vehicle {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @map("company_id") @db.Uuid
  branchId         String?       @map("branch_id") @db.Uuid
  departmentId     String?       @map("department_id") @db.Uuid
  plateNumber      String        @map("plate_number")
  vin              String?
  make             String
  model            String
  year             Int?
  vehicleClass     VehicleClass  @map("vehicle_class")
  ownership        OwnershipType @default(OWNED)
  fuelType         String?       @map("fuel_type")
  capacityKg       Decimal?      @map("capacity_kg") @db.Decimal(12, 2)
  capacityM3       Decimal?      @map("capacity_m3") @db.Decimal(12, 2)
  capacityCases    Int?          @map("capacity_cases")
  capacityPallets  Int?          @map("capacity_pallets")
  /// Max delivery stops per trip (falls back to settings.logistics.defaultMaxStops).
  maxStops         Int?          @map("max_stops")
  odometerKm       Decimal       @default(0) @map("odometer_km") @db.Decimal(12, 1)
  status           VehicleStatus @default(AVAILABLE)
  gpsDeviceId      String?       @map("gps_device_id")
  /// Overrides the company speed limit for overspeed alerts.
  speedLimitKmh    Int?          @map("speed_limit_kmh")
  /// Fuel tank capacity (litres), used to flag implausible refills.
  tankCapacityL    Decimal?      @map("tank_capacity_l") @db.Decimal(8, 1)
  acquiredAt       DateTime?     @map("acquired_at") @db.Date
  disposedAt       DateTime?     @map("disposed_at") @db.Date
  /// Cost of ownership (S12): straight-line depreciation for owned vehicles, monthly lease/rent otherwise.
  purchasePrice    Decimal?      @map("purchase_price") @db.Decimal(14, 2)
  residualValue    Decimal?      @map("residual_value") @db.Decimal(14, 2)
  usefulLifeMonths Int?          @map("useful_life_months")
  monthlyLeaseCost Decimal?      @map("monthly_lease_cost") @db.Decimal(14, 2)
  /// Depreciation / lease start (defaults to acquiredAt).
  inServiceAt      DateTime?     @map("in_service_at") @db.Date
  /// Tire layout key (shared TIRE_LAYOUTS); null = default for the vehicle class (S16).
  tireLayout       String?       @map("tire_layout")
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  company         Company              @relation(fields: [companyId], references: [id])
  branch          Branch?              @relation(fields: [branchId], references: [id])
  department      Department?          @relation(fields: [departmentId], references: [id])
  documents       VehicleDocument[]
  assignments     VehicleAssignment[]
  statusHistory   VehicleStatusEvent[]
  Trip            Trip[]
  FuelRecord      FuelRecord[]
  MaintenancePlan MaintenancePlan[]
  RepairRequest   RepairRequest[]
  WorkOrder       WorkOrder[]
  expenses        VehicleExpense[]
  incidents       Incident[]
  inspections     Inspection[]
  tireChanges     TireChange[]
  tireChecks      TireCheck[]
  warranties      VehicleWarranty[]

  @@unique([companyId, plateNumber])
  @@unique([companyId, gpsDeviceId])
  @@index([companyId, status])
  @@map("vehicles")
}

model VehicleStatusEvent {
  id         String         @id @default(uuid()) @db.Uuid
  companyId  String         @map("company_id") @db.Uuid
  vehicleId  String         @map("vehicle_id") @db.Uuid
  fromStatus VehicleStatus? @map("from_status")
  toStatus   VehicleStatus  @map("to_status")
  reason     String?
  userId     String?        @map("user_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, createdAt])
  @@map("vehicle_status_events")
}

model VehicleDocument {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  vehicleId String       @map("vehicle_id") @db.Uuid
  type      DocumentType
  number    String?
  issuer    String?
  issuedAt  DateTime?    @map("issued_at") @db.Date
  expiresAt DateTime?    @map("expires_at") @db.Date
  amount    Decimal?     @db.Decimal(14, 2)
  fileId    String?      @map("file_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  file    StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([companyId, expiresAt])
  @@map("vehicle_documents")
}

model VehicleAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  vehicleId    String    @map("vehicle_id") @db.Uuid
  driverId     String?   @map("driver_id") @db.Uuid
  branchId     String?   @map("branch_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  note         String?
  startAt      DateTime  @default(now()) @map("start_at")
  endAt        DateTime? @map("end_at")
  createdBy    String?   @map("created_by") @db.Uuid

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver? @relation(fields: [driverId], references: [id])

  @@index([vehicleId, endAt])
  @@index([driverId, endAt])
  @@map("vehicle_assignments")
}

model Driver {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  userId     String?  @unique @map("user_id") @db.Uuid
  employeeNo String   @map("employee_no")
  fullName   String   @map("full_name")
  phone      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company     Company             @relation(fields: [companyId], references: [id])
  branch      Branch?             @relation(fields: [branchId], references: [id])
  user        User?               @relation(fields: [userId], references: [id])
  licenses    DriverLicense[]
  assignments VehicleAssignment[]
  trips       Trip[]
  duty        DutySession[]
  fuelRecords FuelRecord[]
  incidents   Incident[]
  inspections Inspection[]
  trainings   DriverTraining[]
  adjustments DriverAdjustment[]

  @@unique([companyId, employeeNo])
  @@map("drivers")
}

model DriverLicense {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  driverId     String    @map("driver_id") @db.Uuid
  number       String
  licenseClass String    @map("license_class")
  issuedAt     DateTime? @map("issued_at") @db.Date
  expiresAt    DateTime? @map("expires_at") @db.Date
  fileId       String?   @map("file_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  driver Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  file   StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([companyId, expiresAt])
  @@map("driver_licenses")
}

model VehicleLastPosition {
  vehicleId  String   @id @map("vehicle_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  recordedAt DateTime @map("recorded_at")
  latitude   Float
  longitude  Float
  speedKmh   Float?   @map("speed_kmh")
  heading    Float?
  ignition   Boolean?
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("vehicle_last_positions")
}

/// Binary objects (documents, photos, signatures). Content lives in the
/// configured storage driver (local filesystem or S3-compatible); access is
/// always streamed through the API so tenant checks apply.
model StoredFile {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  storageKey  String   @unique @map("storage_key")
  filename    String
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  sha256      String
  uploadedBy  String?  @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  vehicleDocuments VehicleDocument[]
  driverLicenses   DriverLicense[]

  @@index([companyId, createdAt])
  @@map("files")
}

/// In-app notification for one user. `dedupeKey` prevents repeated alerts
/// for the same event/threshold.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  topic     String
  severity  String    @default("info")
  title     String
  body      String
  data      Json?
  dedupeKey String?   @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  emailedAt DateTime? @map("emailed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

enum GeofenceShape {
  CIRCLE
  POLYGON
}

enum TelemetryEventType {
  GEOFENCE_ENTER
  GEOFENCE_EXIT
  OVERSPEED
  IDLE
  IGNITION_ON
  IGNITION_OFF
  GPS_OFFLINE
  GPS_RESTORED
  HARSH_ACCEL
  HARSH_BRAKE
  HARSH_CORNER
  OFF_ROUTE
  UNAUTHORISED_MOVEMENT
  AFTER_HOURS
  NO_DRIVER
  RESTRICTED_AREA
  FUEL_REFILL
  FUEL_DROP
  ENGINE_FAULT
}

/// Virtual boundary: branch, warehouse, customer site, restricted area…
model Geofence {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  name         String
  category     String        @default("SITE")
  shape        GeofenceShape
  /// CIRCLE: centre + radius
  centerLat    Float?        @map("center_lat")
  centerLng    Float?        @map("center_lng")
  radiusM      Float?        @map("radius_m")
  /// POLYGON: [[lng, lat], ...] (GeoJSON order, not closed)
  polygon      Json?
  alertOnEnter Boolean       @default(false) @map("alert_on_enter")
  alertOnExit  Boolean       @default(false) @map("alert_on_exit")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([companyId, active])
  @@map("geofences")
}

/// Detected telematics events (append-only; durations filled when an episode ends).
model TelemetryEvent {
  id         String             @id @default(uuid()) @db.Uuid
  companyId  String             @map("company_id") @db.Uuid
  vehicleId  String             @map("vehicle_id") @db.Uuid
  /// Driver at the time (ongoing trip driver, else standing assignment).
  driverId   String?            @map("driver_id") @db.Uuid
  type       TelemetryEventType
  occurredAt DateTime           @map("occurred_at")
  endedAt    DateTime?          @map("ended_at")
  latitude   Float?
  longitude  Float?
  speedKmh   Float?             @map("speed_kmh")
  geofenceId String?            @map("geofence_id") @db.Uuid
  data       Json?
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([companyId, occurredAt])
  @@index([vehicleId, occurredAt])
  @@index([driverId, occurredAt])
  @@map("telemetry_events")
}

/// Per-vehicle rules-engine state carried between ingest batches.
model VehicleTelemetryState {
  vehicleId         String    @id @map("vehicle_id") @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  lastFixAt         DateTime? @map("last_fix_at")
  ignition          Boolean?
  lastSpeedKmh      Float?    @map("last_speed_kmh")
  lastHeading       Float?    @map("last_heading")
  insideGeofenceIds String[]  @map("inside_geofence_ids")
  overspeedEventId  String?   @map("overspeed_event_id") @db.Uuid
  overspeedMaxKmh   Float?    @map("overspeed_max_kmh")
  idleSince         DateTime? @map("idle_since")
  idleEventId       String?   @map("idle_event_id") @db.Uuid
  offlineEventId    String?   @map("offline_event_id") @db.Uuid
  /// Control rules (S12): open episodes and their start.
  lastLat           Float?    @map("last_lat")
  lastLng           Float?    @map("last_lng")
  offRouteSince     DateTime? @map("off_route_since")
  offRouteEventId   String?   @map("off_route_event_id") @db.Uuid
  offRouteMaxM      Float?    @map("off_route_max_m")
  noTripKm          Float?    @map("no_trip_km")
  noTripEventId     String?   @map("no_trip_event_id") @db.Uuid
  afterHoursEventId String?   @map("after_hours_event_id") @db.Uuid
  noDriverEventId   String?   @map("no_driver_event_id") @db.Uuid
  /// Fuel level sensor (S13): recent raw samples [[epochMs, litres]], smoothed level and the episode in progress.
  fuelSamples       Json?     @map("fuel_samples")
  fuelLevelL        Float?    @map("fuel_level_l")
  fuelRiseFrom      Float?    @map("fuel_rise_from")
  fuelDropFrom      Float?    @map("fuel_drop_from")
  /// Delivery stop the vehicle is at (GPS), and its open visit (S14).
  atStopId          String?   @map("at_stop_id") @db.Uuid
  stopVisitId       String?   @map("stop_visit_id") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("vehicle_telemetry_state")
}

enum TripKind {
  GENERAL
  DELIVERY
}

enum TripStatus {
  PLANNED
  ASSIGNED
  ONGOING
  COMPLETED
  CANCELLED
}

/// Per-company sequence numbers (trip numbers, work orders…).
model CompanyCounter {
  companyId String @map("company_id") @db.Uuid
  key       String
  value     Int    @default(0)

  @@id([companyId, key])
  @@map("company_counters")
}

/// A transport task: one vehicle + driver from origin to destination.
model Trip {
  id               String     @id @default(uuid()) @db.Uuid
  companyId        String     @map("company_id") @db.Uuid
  tripNo           String     @map("trip_no")
  branchId         String?    @map("branch_id") @db.Uuid
  vehicleId        String?    @map("vehicle_id") @db.Uuid
  driverId         String?    @map("driver_id") @db.Uuid
  status           TripStatus @default(PLANNED)
  kind             TripKind   @default(GENERAL)
  /// Delivery date (company-local) of a delivery load.
  plannedDate      DateTime?  @map("planned_date") @db.Date
  /// Planned route (S11): road km/minutes from OSRM, or straight-line estimates.
  plannedKm        Decimal?   @map("planned_km") @db.Decimal(10, 1)
  plannedMinutes   Int?       @map("planned_minutes")
  /// Encoded polyline (precision 5) of the planned route.
  routeGeometry    String?    @map("route_geometry")
  routingSource    String?    @map("routing_source")
  /// Warehouse check-in after a delivery trip.
  checkedInAt      DateTime?  @map("checked_in_at")
  checkedInBy      String?    @map("checked_in_by") @db.Uuid
  checkIn          Json?      @map("check_in")
  purpose          String?
  originName       String     @map("origin_name")
  originLat        Float?     @map("origin_lat")
  originLng        Float?     @map("origin_lng")
  destinationName  String     @map("destination_name")
  destinationLat   Float?     @map("destination_lat")
  destinationLng   Float?     @map("destination_lng")
  plannedStart     DateTime   @map("planned_start")
  plannedEnd       DateTime   @map("planned_end")
  actualStart      DateTime?  @map("actual_start")
  actualEnd        DateTime?  @map("actual_end")
  startOdometerKm  Decimal?   @map("start_odometer_km") @db.Decimal(12, 1)
  endOdometerKm    Decimal?   @map("end_odometer_km") @db.Decimal(12, 1)
  gpsDistanceKm    Decimal?   @map("gps_distance_km") @db.Decimal(10, 1)
  cargoDescription String?    @map("cargo_description")
  cargoWeightKg    Decimal?   @map("cargo_weight_kg") @db.Decimal(12, 2)
  notes            String?
  cancelReason     String?    @map("cancel_reason")
  createdBy        String?    @map("created_by") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  vehicle       Vehicle?          @relation(fields: [vehicleId], references: [id])
  driver        Driver?           @relation(fields: [driverId], references: [id])
  statusHistory TripStatusEvent[]
  stops         TripStop[]
  orders        DeliveryOrder[]

  @@unique([companyId, tripNo])
  @@index([companyId, plannedStart])
  @@index([vehicleId, plannedStart])
  @@index([driverId, plannedStart])
  @@index([companyId, status])
  @@map("trips")
}

model TripStatusEvent {
  id         String      @id @default(uuid()) @db.Uuid
  companyId  String      @map("company_id") @db.Uuid
  tripId     String      @map("trip_id") @db.Uuid
  fromStatus TripStatus? @map("from_status")
  toStatus   TripStatus  @map("to_status")
  note       String?
  userId     String?     @map("user_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
  @@map("trip_status_events")
}

/// Driver on-duty session (attendance). endedAt null = currently on duty.
model DutySession {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  driverId  String    @map("driver_id") @db.Uuid
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")
  source    String    @default("web")
  createdBy String?   @map("created_by") @db.Uuid

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, startedAt])
  @@index([companyId, startedAt])
  @@map("duty_sessions")
}

// ---------------------------------------------------------------------------
// Fuel (Sprint 5)
// ---------------------------------------------------------------------------

model FuelRecord {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @map("company_id") @db.Uuid
  vehicleId        String        @map("vehicle_id") @db.Uuid
  driverId         String?       @map("driver_id") @db.Uuid
  filledAt         DateTime      @map("filled_at")
  odometerKm       Decimal       @map("odometer_km") @db.Decimal(12, 1)
  litres           Decimal       @db.Decimal(10, 2)
  unitPrice        Decimal       @map("unit_price") @db.Decimal(12, 2)
  totalCost        Decimal       @map("total_cost") @db.Decimal(14, 2)
  fuelType         String?       @map("fuel_type")
  station          String?
  fullTank         Boolean       @default(true) @map("full_tank")
  paymentMethod    String?       @map("payment_method")
  receiptFileId    String?       @map("receipt_file_id") @db.Uuid
  notes            String?
  source           String        @default("web")
  /// Where the fill happened (S13): phone GPS of the driver, or the vehicle's GPS position at fill time.
  latitude         Float?
  longitude        Float?
  locationSource   String?       @map("location_source")
  /// Distance between the fill location and the vehicle's GPS position at fill time.
  vehicleDistanceM Float?        @map("vehicle_distance_m")
  /// GPS km since the previous fill (compared with the odometer distance).
  gpsKm            Decimal?      @map("gps_km") @db.Decimal(10, 1)
  /// Fuel card transaction this fill was reconciled with.
  cardTxnId        String?       @map("card_txn_id") @db.Uuid
  /// Computed (full-to-full): distance since previous full fill and efficiency.
  distanceKm       Decimal?      @map("distance_km") @db.Decimal(10, 1)
  kmPerLitre       Decimal?      @map("km_per_litre") @db.Decimal(8, 2)
  /// Anomaly flags, e.g. ["ODOMETER_BACKWARDS", "OVER_TANK_CAPACITY", "LOW_EFFICIENCY"]
  flags            String[]      @default([])
  /// APPROVED unless the cost needed approval (settings.approvals.fuelAbove).
  approvalStatus   EntryApproval @default(APPROVED) @map("approval_status")
  createdBy        String?       @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver? @relation(fields: [driverId], references: [id])

  @@index([vehicleId, filledAt])
  @@index([companyId, filledAt])
  @@map("fuel_records")
}

// ---------------------------------------------------------------------------
// Maintenance (Sprint 5)
// ---------------------------------------------------------------------------

enum WorkOrderStatus {
  AWAITING_APPROVAL
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkOrderType {
  PREVENTIVE
  CORRECTIVE
  ACCIDENT
  INSPECTION
}

enum RepairRequestStatus {
  OPEN
  CONVERTED
  REJECTED
}

/// Preventive maintenance schedule for one vehicle (by distance and/or time).
model MaintenancePlan {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  vehicleId          String    @map("vehicle_id") @db.Uuid
  name               String
  intervalKm         Int?      @map("interval_km")
  intervalDays       Int?      @map("interval_days")
  lastDoneAt         DateTime? @map("last_done_at")
  lastDoneOdometerKm Decimal?  @map("last_done_odometer_km") @db.Decimal(12, 1)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  vehicle    Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]

  @@index([companyId, active])
  @@index([vehicleId])
  @@map("maintenance_plans")
}

model RepairRequest {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @map("company_id") @db.Uuid
  vehicleId   String              @map("vehicle_id") @db.Uuid
  reportedBy  String?             @map("reported_by") @db.Uuid
  description String
  severity    String              @default("MEDIUM")
  odometerKm  Decimal?            @map("odometer_km") @db.Decimal(12, 1)
  photoFileId String?             @map("photo_file_id") @db.Uuid
  status      RepairRequestStatus @default(OPEN)
  resolution  String?
  workOrderId String?             @map("work_order_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([companyId, status])
  @@map("repair_requests")
}

model WorkOrder {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  woNo          String          @map("wo_no")
  vehicleId     String          @map("vehicle_id") @db.Uuid
  planId        String?         @map("plan_id") @db.Uuid
  type          WorkOrderType
  status        WorkOrderStatus @default(OPEN)
  priority      String          @default("MEDIUM")
  title         String
  description   String?
  workshop      String?
  assignedTo    String?         @map("assigned_to")
  /// When true the vehicle is UNDER_REPAIR while the work order is in progress.
  offRoad       Boolean         @default(true) @map("off_road")
  odometerKm    Decimal?        @map("odometer_km") @db.Decimal(12, 1)
  openedAt      DateTime        @default(now()) @map("opened_at")
  startedAt     DateTime?       @map("started_at")
  completedAt   DateTime?       @map("completed_at")
  resolution    String?
  totalCost     Decimal         @default(0) @map("total_cost") @db.Decimal(14, 2)
  /// Planned cost; above settings.approvals.workOrderAbove the WO needs approval before it starts.
  estimatedCost Decimal?        @map("estimated_cost") @db.Decimal(14, 2)
  /// Outside garage (S16).
  supplierId    String?         @map("supplier_id") @db.Uuid
  quoteAmount   Decimal?        @map("quote_amount") @db.Decimal(14, 2)
  quoteFileId   String?         @map("quote_file_id") @db.Uuid
  quotedAt      DateTime?       @map("quoted_at")
  invoiceNo     String?         @map("invoice_no")
  invoiceDate   DateTime?       @map("invoice_date") @db.Date
  invoiceAmount Decimal?        @map("invoice_amount") @db.Decimal(14, 2)
  invoiceFileId String?         @map("invoice_file_id") @db.Uuid
  createdBy     String?         @map("created_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  supplier       Supplier?        @relation(fields: [supplierId], references: [id])
  vehicle        Vehicle          @relation(fields: [vehicleId], references: [id])
  plan           MaintenancePlan? @relation(fields: [planId], references: [id])
  lines          WorkOrderLine[]
  repairRequests RepairRequest[]

  @@unique([companyId, woNo])
  @@index([companyId, status])
  @@index([vehicleId, openedAt])
  @@map("work_orders")
}

model WorkOrderLine {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  workOrderId     String    @map("work_order_id") @db.Uuid
  kind            String
  description     String
  quantity        Decimal   @db.Decimal(10, 2)
  unitCost        Decimal   @map("unit_cost") @db.Decimal(14, 2)
  total           Decimal   @db.Decimal(14, 2)
  /// PART lines issued from a store (S16).
  partId          String?   @map("part_id") @db.Uuid
  branchId        String?   @map("branch_id") @db.Uuid
  warrantyUntil   DateTime? @map("warranty_until") @db.Date
  warrantyKmUntil Decimal?  @map("warranty_km_until") @db.Decimal(12, 1)
  /// TIRE lines created from a tire change.
  tireChangeId    String?   @map("tire_change_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part      Part?     @relation(fields: [partId], references: [id])

  @@index([workOrderId])
  @@map("work_order_lines")
}

// ---------------------------------------------------------------------------
// Costs, analytics, devices (Sprint 6)
// ---------------------------------------------------------------------------

/// Operating expenses other than fuel and maintenance (tolls, parking, fines…).
model VehicleExpense {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  vehicleId      String        @map("vehicle_id") @db.Uuid
  tripId         String?       @map("trip_id") @db.Uuid
  category       String
  incurredAt     DateTime      @map("incurred_at")
  amount         Decimal       @db.Decimal(14, 2)
  description    String?
  receiptFileId  String?       @map("receipt_file_id") @db.Uuid
  createdBy      String?       @map("created_by") @db.Uuid
  /// APPROVED unless the amount needed approval (settings.approvals.expenseAbove).
  approvalStatus EntryApproval @default(APPROVED) @map("approval_status")
  createdAt      DateTime      @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([companyId, incurredAt])
  @@index([vehicleId, incurredAt])
  @@map("vehicle_expenses")
}

/// Per vehicle per company-local day, rolled up from GPS positions by the worker.
model VehicleDailyStat {
  vehicleId     String   @map("vehicle_id") @db.Uuid
  day           DateTime @db.Date
  companyId     String   @map("company_id") @db.Uuid
  distanceKm    Decimal  @default(0) @map("distance_km") @db.Decimal(10, 2)
  engineMinutes Int      @default(0) @map("engine_minutes")
  movingMinutes Int      @default(0) @map("moving_minutes")
  idleMinutes   Int      @default(0) @map("idle_minutes")
  maxSpeedKmh   Float?   @map("max_speed_kmh")
  positions     Int      @default(0)
  computedAt    DateTime @default(now()) @map("computed_at")

  @@id([vehicleId, day])
  @@index([companyId, day])
  @@map("vehicle_daily_stats")
}

/// Mobile push tokens (Expo) per user.
model UserDevice {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  pushToken  String   @unique @map("push_token")
  platform   String
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_devices")
}

// ---------------------------------------------------------------------------
// Safety: incidents & insurance claims (Phase 2 / S7)
// ---------------------------------------------------------------------------

enum IncidentType {
  COLLISION
  DAMAGE
  THEFT
  INJURY
  NEAR_MISS
  BREAKDOWN
  OTHER
}

enum IncidentStatus {
  REPORTED
  INVESTIGATING
  CLOSED
}

enum ClaimStatus {
  PENDING_APPROVAL
  SUBMITTED
  APPROVED
  REJECTED
  SETTLED
}

model Incident {
  id                String         @id @default(uuid()) @db.Uuid
  companyId         String         @map("company_id") @db.Uuid
  incidentNo        String         @map("incident_no")
  vehicleId         String?        @map("vehicle_id") @db.Uuid
  driverId          String?        @map("driver_id") @db.Uuid
  tripId            String?        @map("trip_id") @db.Uuid
  type              IncidentType
  severity          String         @default("MEDIUM")
  status            IncidentStatus @default(REPORTED)
  occurredAt        DateTime       @map("occurred_at")
  latitude          Float?
  longitude         Float?
  location          String?
  description       String
  injuries          Boolean        @default(false)
  thirdParty        String?        @map("third_party")
  policeReportNo    String?        @map("police_report_no")
  estimatedCost     Decimal?       @map("estimated_cost") @db.Decimal(14, 2)
  photoFileIds      String[]       @default([]) @map("photo_file_ids")
  findings          String?
  correctiveActions String?        @map("corrective_actions")
  workOrderId       String?        @map("work_order_id") @db.Uuid
  reportedBy        String?        @map("reported_by") @db.Uuid
  closedAt          DateTime?      @map("closed_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  vehicle Vehicle?         @relation(fields: [vehicleId], references: [id])
  driver  Driver?          @relation(fields: [driverId], references: [id])
  claims  InsuranceClaim[]

  @@unique([companyId, incidentNo])
  @@index([companyId, occurredAt])
  @@index([driverId, occurredAt])
  @@map("incidents")
}

model InsuranceClaim {
  id             String      @id @default(uuid()) @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  claimNo        String      @map("claim_no")
  incidentId     String      @map("incident_id") @db.Uuid
  insurer        String?
  policyNo       String?     @map("policy_no")
  externalRef    String?     @map("external_ref")
  status         ClaimStatus @default(SUBMITTED)
  submittedAt    DateTime    @default(now()) @map("submitted_at")
  amountClaimed  Decimal     @map("amount_claimed") @db.Decimal(14, 2)
  amountApproved Decimal?    @map("amount_approved") @db.Decimal(14, 2)
  amountPaid     Decimal?    @map("amount_paid") @db.Decimal(14, 2)
  decidedAt      DateTime?   @map("decided_at")
  settledAt      DateTime?   @map("settled_at")
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([companyId, claimNo])
  @@index([companyId, status])
  @@map("insurance_claims")
}

// ---------------------------------------------------------------------------
// Phase 2 / S8: inspections, training, incentives
// ---------------------------------------------------------------------------

enum InspectionKind {
  PRE_TRIP
  POST_TRIP
  PERIODIC
}

enum InspectionResult {
  PASS
  DEFECTS
  FAIL
}

model InspectionTemplate {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  name           String
  kind           InspectionKind
  /// Vehicle classes this checklist applies to; empty = all.
  vehicleClasses String[]       @default([]) @map("vehicle_classes")
  /// [{ key, label, critical }]
  items          Json
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  inspections Inspection[]

  @@index([companyId, kind])
  @@map("inspection_templates")
}

model Inspection {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  inspectionNo    String           @map("inspection_no")
  vehicleId       String           @map("vehicle_id") @db.Uuid
  driverId        String?          @map("driver_id") @db.Uuid
  tripId          String?          @map("trip_id") @db.Uuid
  templateId      String           @map("template_id") @db.Uuid
  kind            InspectionKind
  performedAt     DateTime         @map("performed_at")
  odometerKm      Decimal?         @map("odometer_km") @db.Decimal(12, 1)
  latitude        Float?
  longitude       Float?
  /// [{ key, label, critical, ok, note, photoFileId }]
  items           Json
  defects         Int              @default(0)
  criticalDefects Int              @default(0) @map("critical_defects")
  result          InspectionResult
  notes           String?
  performedBy     String?          @map("performed_by") @db.Uuid
  repairRequestId String?          @map("repair_request_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")

  vehicle  Vehicle            @relation(fields: [vehicleId], references: [id])
  driver   Driver?            @relation(fields: [driverId], references: [id])
  template InspectionTemplate @relation(fields: [templateId], references: [id])

  @@unique([companyId, inspectionNo])
  @@index([companyId, performedAt])
  @@index([vehicleId, kind, performedAt])
  @@map("inspections")
}

model TrainingCourse {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  code           String
  name           String
  description    String?
  /// Certificate validity; null = does not expire.
  validityMonths Int?     @map("validity_months")
  /// Every active driver must hold a valid record.
  mandatory      Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  records DriverTraining[]

  @@unique([companyId, code])
  @@map("training_courses")
}

model DriverTraining {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  driverId          String    @map("driver_id") @db.Uuid
  courseId          String    @map("course_id") @db.Uuid
  completedAt       DateTime  @map("completed_at") @db.Date
  expiresAt         DateTime? @map("expires_at") @db.Date
  provider          String?
  score             Decimal?  @db.Decimal(5, 1)
  certificateNo     String?   @map("certificate_no")
  certificateFileId String?   @map("certificate_file_id") @db.Uuid
  notes             String?
  createdBy         String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")

  driver Driver         @relation(fields: [driverId], references: [id])
  course TrainingCourse @relation(fields: [courseId], references: [id])

  @@index([driverId, courseId])
  @@index([companyId, expiresAt])
  @@map("driver_trainings")
}

enum AdjustmentKind {
  INCENTIVE
  PENALTY
}

enum AdjustmentStatus {
  PROPOSED
  APPROVED
  REJECTED
}

model DriverAdjustment {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  driverId     String           @map("driver_id") @db.Uuid
  kind         AdjustmentKind
  category     String
  /// Payroll month, YYYY-MM.
  period       String
  amount       Decimal          @db.Decimal(14, 2)
  reason       String
  status       AdjustmentStatus @default(PROPOSED)
  /// "manual" or an automatic rule, e.g. "auto:safety-bonus".
  source       String           @default("manual")
  /// Prevents an automatic rule from proposing twice.
  dedupeKey    String?          @map("dedupe_key")
  incidentId   String?          @map("incident_id") @db.Uuid
  proposedBy   String?          @map("proposed_by") @db.Uuid
  decidedBy    String?          @map("decided_by") @db.Uuid
  decidedAt    DateTime?        @map("decided_at")
  decisionNote String?          @map("decision_note")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([companyId, dedupeKey])
  @@index([companyId, period])
  @@index([driverId, period])
  @@map("driver_adjustments")
}

// ---------------------------------------------------------------------------
// Phase 2 / S9: integration platform & approvals
// ---------------------------------------------------------------------------

enum EntryApproval {
  APPROVED
  PENDING
  REJECTED
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  name       String
  /// Public part of the key (fms_<prefix>_<secret>), used for lookup.
  prefix     String    @unique
  /// SHA-256 of the full key; the key itself is never stored.
  keyHash    String    @map("key_hash")
  scopes     String[]
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([companyId])
  @@map("api_keys")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  /// Customer / outlet code from the DMS.
  code      String
  name      String
  phone     String?
  email     String?
  address   String?
  township  String?
  city      String?
  latitude  Float?
  longitude Float?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders DeliveryOrder[]
  stops  TripStop[]

  @@unique([companyId, code])
  @@map("customers")
}

enum DeliveryOrderStatus {
  RECEIVED
  PLANNED
  DISPATCHED
  DELIVERED
  PARTIAL
  FAILED
  RETURNED
  CANCELLED
}

model DeliveryOrder {
  id            String              @id @default(uuid()) @db.Uuid
  companyId     String              @map("company_id") @db.Uuid
  /// Sending system, e.g. "dms".
  source        String              @default("dms")
  /// Order number in the sending system.
  externalRef   String              @map("external_ref")
  customerId    String              @map("customer_id") @db.Uuid
  status        DeliveryOrderStatus @default(RECEIVED)
  priority      String              @default("NORMAL")
  orderDate     DateTime?           @map("order_date")
  windowStart   DateTime?           @map("window_start")
  windowEnd     DateTime?           @map("window_end")
  /// Delivery address when different from the customer's.
  address       String?
  latitude      Float?
  longitude     Float?
  contactName   String?             @map("contact_name")
  contactPhone  String?             @map("contact_phone")
  totalWeightKg Decimal?            @map("total_weight_kg") @db.Decimal(12, 2)
  totalVolumeM3 Decimal?            @map("total_volume_m3") @db.Decimal(12, 3)
  codAmount     Decimal?            @map("cod_amount") @db.Decimal(14, 2)
  notes         String?
  /// Hash of the last accepted payload: an identical PUT is a no-op.
  payloadHash   String              @map("payload_hash")
  /// Depot (branch) the order ships from.
  branchId      String?             @map("branch_id") @db.Uuid
  /// Company-local delivery date used for planning.
  deliveryDate  DateTime?           @map("delivery_date") @db.Date
  totalCases    Decimal?            @map("total_cases") @db.Decimal(12, 2)
  totalPallets  Decimal?            @map("total_pallets") @db.Decimal(12, 2)
  tripId        String?             @map("trip_id") @db.Uuid
  stopId        String?             @map("stop_id") @db.Uuid
  failureReason String?             @map("failure_reason")
  deliveredAt   DateTime?           @map("delivered_at")
  version       Int                 @default(1)
  cancelledAt   DateTime?           @map("cancelled_at")
  cancelReason  String?             @map("cancel_reason")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  customer Customer            @relation(fields: [customerId], references: [id])
  lines    DeliveryOrderLine[]
  trip     Trip?               @relation(fields: [tripId], references: [id])
  stop     TripStop?           @relation(fields: [stopId], references: [id])

  @@unique([companyId, source, externalRef])
  @@index([companyId, deliveryDate, status])
  @@index([tripId])
  @@index([companyId, updatedAt])
  @@index([companyId, status])
  @@map("delivery_orders")
}

model DeliveryOrderLine {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  lineNo       Int      @map("line_no")
  sku          String
  description  String?
  quantity     Decimal  @db.Decimal(14, 3)
  uom          String   @default("EA")
  weightKg     Decimal? @map("weight_kg") @db.Decimal(12, 2)
  volumeM3     Decimal? @map("volume_m3") @db.Decimal(12, 3)
  cases        Decimal? @db.Decimal(12, 2)
  pallets      Decimal? @db.Decimal(12, 2)
  /// Quantity actually delivered (set on PARTIAL / DELIVERED).
  deliveredQty Decimal? @map("delivered_qty") @db.Decimal(14, 3)

  order DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, lineNo])
  @@map("delivery_order_lines")
}

model WebhookEndpoint {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  url                 String
  description         String?
  /// HMAC-SHA256 signing secret (shown to the admin; needed to sign, so stored).
  secret              String
  events              String[]
  active              Boolean  @default(true)
  consecutiveFailures Int      @default(0) @map("consecutive_failures")
  disabledReason      String?  @map("disabled_reason")
  createdBy           String?  @map("created_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([companyId])
  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  companyId      String                @map("company_id") @db.Uuid
  endpointId     String                @map("endpoint_id") @db.Uuid
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now()) @map("next_attempt_at")
  lastAttemptAt  DateTime?             @map("last_attempt_at")
  responseStatus Int?                  @map("response_status")
  lastError      String?               @map("last_error")
  deliveredAt    DateTime?             @map("delivered_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

enum ApprovalKind {
  WORK_ORDER
  EXPENSE
  FUEL
  VEHICLE_REQUEST
  CLAIM
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequest {
  id                String         @id @default(uuid()) @db.Uuid
  companyId         String         @map("company_id") @db.Uuid
  kind              ApprovalKind
  entityId          String         @map("entity_id") @db.Uuid
  title             String
  amount            Decimal?       @db.Decimal(14, 2)
  requestedBy       String?        @map("requested_by") @db.Uuid
  status            ApprovalStatus @default(PENDING)
  requiredApprovals Int            @default(1) @map("required_approvals")
  decidedAt         DateTime?      @map("decided_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  decisions ApprovalDecision[]

  @@index([companyId, status])
  @@index([entityId])
  @@map("approval_requests")
}

model ApprovalDecision {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  requestId  String   @map("request_id") @db.Uuid
  approverId String   @map("approver_id") @db.Uuid
  decision   String
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, approverId])
  @@map("approval_decisions")
}

enum VehicleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  SCHEDULED
  CANCELLED
}

model VehicleRequest {
  id               String               @id @default(uuid()) @db.Uuid
  companyId        String               @map("company_id") @db.Uuid
  requestNo        String               @map("request_no")
  requestedBy      String               @map("requested_by") @db.Uuid
  purpose          String
  originName       String               @map("origin_name")
  destinationName  String               @map("destination_name")
  plannedStart     DateTime             @map("planned_start")
  plannedEnd       DateTime             @map("planned_end")
  passengers       Int?
  cargoDescription String?              @map("cargo_description")
  preferredClass   String?              @map("preferred_class")
  notes            String?
  status           VehicleRequestStatus @default(PENDING)
  tripId           String?              @map("trip_id") @db.Uuid
  rejectionReason  String?              @map("rejection_reason")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@unique([companyId, requestNo])
  @@index([companyId, status])
  @@index([requestedBy])
  @@map("vehicle_requests")
}

// ---------------------------------------------------------------------------
// Phase 2 / S10: multi-stop delivery trips
// ---------------------------------------------------------------------------

enum StopStatus {
  PENDING
  ARRIVED
  DELIVERED
  PARTIAL
  FAILED
}

model TripStop {
  id              String     @id @default(uuid()) @db.Uuid
  companyId       String     @map("company_id") @db.Uuid
  tripId          String     @map("trip_id") @db.Uuid
  seq             Int
  customerId      String     @map("customer_id") @db.Uuid
  name            String
  address         String?
  latitude        Float?
  longitude       Float?
  contactName     String?    @map("contact_name")
  contactPhone    String?    @map("contact_phone")
  status          StopStatus @default(PENDING)
  arrivedAt       DateTime?  @map("arrived_at")
  /// 'gps' when the arrival was detected from the vehicle position (S14), else 'driver' / 'dispatch'.
  arrivalSource   String?    @map("arrival_source")
  completedAt     DateTime?  @map("completed_at")
  failureReason   String?    @map("failure_reason")
  notes           String?
  plannedArrival  DateTime?  @map("planned_arrival")
  /// Proof of delivery
  podPhotoFileIds String[]   @default([]) @map("pod_photo_file_ids")
  podSignature    Json?      @map("pod_signature")
  podSignedBy     String?    @map("pod_signed_by")
  podLat          Float?     @map("pod_lat")
  podLng          Float?     @map("pod_lng")
  podAccuracyM    Float?     @map("pod_accuracy_m")
  podDistanceM    Int?       @map("pod_distance_m")
  codExpected     Decimal?   @map("cod_expected") @db.Decimal(14, 2)
  codCollected    Decimal?   @map("cod_collected") @db.Decimal(14, 2)
  /// FAR_FROM_CUSTOMER, NO_GPS, COD_SHORT, COD_OVER
  podFlags        String[]   @default([]) @map("pod_flags")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  returns  DeliveryReturn[]
  trip     Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  customer Customer         @relation(fields: [customerId], references: [id])
  orders   DeliveryOrder[]

  @@index([tripId, seq])
  @@map("trip_stops")
}

/// Goods a customer hands back at a stop (damaged, expired, wrong item…).
model DeliveryReturn {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  stopId      String   @map("stop_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  orderId     String?  @map("order_id") @db.Uuid
  sku         String
  description String?
  quantity    Decimal  @db.Decimal(14, 3)
  uom         String   @default("EA")
  reason      String
  photoFileId String?  @map("photo_file_id") @db.Uuid
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  stop TripStop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([companyId, createdAt])
  @@map("delivery_returns")
}

/// Monthly budget per scope (company, a branch or a department) and cost category.
model Budget {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  /// YYYY-MM
  period       String
  /// 'company' | 'branch:<id>' | 'department:<id>'
  scopeKey     String   @map("scope_key")
  branchId     String?  @map("branch_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  category     String
  amount       Decimal  @db.Decimal(14, 2)
  /// Highest alert level already sent (90 / 100).
  alertedLevel Int?     @map("alerted_level")
  updatedBy    String?  @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([companyId, period, scopeKey, category])
  @@index([companyId, period])
  @@map("budgets")
}

/// Costs not tied to one vehicle (overheads, fleet policies), allocated to vehicles by km in the month.
model SharedCost {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  /// YYYY-MM
  period       String
  branchId     String?  @map("branch_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  category     String
  description  String
  amount       Decimal  @db.Decimal(14, 2)
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId, period])
  @@map("shared_costs")
}

/// Company fuel cards (S13). Only the last digits are stored.
model FuelCard {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  provider  String
  /// Masked number, e.g. **** 1234 (last 4 kept for matching statements).
  last4     String
  label     String?
  vehicleId String?  @map("vehicle_id") @db.Uuid
  driverId  String?  @map("driver_id") @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, provider, last4])
  @@map("fuel_cards")
}

/// A statement upload or an API sync run.
model FuelCardImport {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  provider   String
  source     String // 'file' | 'api'
  filename   String?
  rows       Int      @default(0)
  imported   Int      @default(0)
  duplicates Int      @default(0)
  errors     Json?
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@map("fuel_card_imports")
}

model FuelCardTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  importId     String?  @map("import_id") @db.Uuid
  provider     String
  /// Provider's transaction id, or a hash of the row for statements without one (dedupe).
  externalId   String   @map("external_id")
  cardLast4    String   @map("card_last4")
  cardId       String?  @map("card_id") @db.Uuid
  vehicleId    String?  @map("vehicle_id") @db.Uuid
  occurredAt   DateTime @map("occurred_at")
  station      String?
  product      String?
  litres       Decimal? @db.Decimal(10, 2)
  amount       Decimal  @db.Decimal(14, 2)
  plate        String?
  /// MATCHED | MISMATCH | CARD_ONLY | ACCEPTED | NON_FUEL
  status       String   @default("CARD_ONLY")
  fuelRecordId String?  @map("fuel_record_id") @db.Uuid
  differences  Json?
  note         String?
  reviewedBy   String?  @map("reviewed_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([companyId, provider, externalId])
  @@index([companyId, occurredAt])
  @@index([vehicleId, occurredAt])
  @@map("fuel_card_transactions")
}

/// Latest engine diagnostics per vehicle (from GPS device attributes).
model VehicleDiagnostics {
  vehicleId    String   @id @map("vehicle_id") @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  recordedAt   DateTime @map("recorded_at")
  /// Active trouble codes, e.g. ["P0300"].
  dtcCodes     String[] @default([]) @map("dtc_codes")
  checkEngine  Boolean? @map("check_engine")
  coolantTempC Float?   @map("coolant_temp_c")
  batteryV     Float?   @map("battery_v")
  engineHours  Float?   @map("engine_hours")
  fuelLevelL   Float?   @map("fuel_level_l")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("vehicle_diagnostics")
}

/// Time spent at a site (S14): a geofence (depot, warehouse, customer site…) or a delivery stop's location.
model SiteVisit {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  vehicleId   String    @map("vehicle_id") @db.Uuid
  driverId    String?   @map("driver_id") @db.Uuid
  tripId      String?   @map("trip_id") @db.Uuid
  /// 'GEOFENCE' | 'STOP'
  kind        String
  geofenceId  String?   @map("geofence_id") @db.Uuid
  stopId      String?   @map("stop_id") @db.Uuid
  customerId  String?   @map("customer_id") @db.Uuid
  siteName    String    @map("site_name")
  /// Geofence category (BRANCH, WAREHOUSE, CUSTOMER, SITE, RESTRICTED) or CUSTOMER for stops.
  category    String
  enteredAt   DateTime  @map("entered_at")
  exitedAt    DateTime? @map("exited_at")
  durationMin Float?    @map("duration_min")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([companyId, enteredAt])
  @@index([vehicleId, enteredAt])
  @@index([stopId])
  @@map("site_visits")
}

/// One-time tokens sent by email (S14): account invitation or password reset. Only a hash is stored.
model AuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// 'INVITE' | 'RESET'
  kind      String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, kind])
  @@map("auth_tokens")
}

/// A company's own identity provider (S15). The group providers come from configuration instead.
model SsoProvider {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  /// 'ENTRA' | 'GOOGLE'
  kind            String
  /// Entra tenant id, or the Google Workspace domain (hd).
  tenant          String
  clientId        String   @map("client_id")
  /// AES-256-GCM (SSO_ENCRYPTION_KEY): iv.tag.ciphertext, base64url.
  clientSecretEnc String   @map("client_secret_enc")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("sso_providers")
}

/// E-mail domain → company and identity provider (S15).
model SsoDomain {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  domain     String    @unique
  /// 'GROUP_ENTRA' | 'GROUP_GOOGLE' | 'COMPANY' (providerId set)
  source     String
  providerId String?   @map("provider_id") @db.Uuid
  /// Group providers need a super admin's approval; a company's own provider is trusted for its domains.
  approvedAt DateTime? @map("approved_at")
  approvedBy String?   @map("approved_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([companyId])
  @@map("sso_domains")
}

/// Scheduled management report by e-mail (S15).
model ReportSubscription {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  /// FLEET | BUDGET | DELIVERY | SAFETY
  report      String
  /// DAILY | WEEKLY | MONTHLY
  frequency   String
  branchId    String?  @map("branch_id") @db.Uuid
  userIds     String[] @map("user_ids") @db.Uuid
  extraEmails String[] @map("extra_emails")
  enabled     Boolean  @default(true)
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("report_subscriptions")
}

model ReportRun {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  /// e.g. 2026-11-15 (daily), 2026-W46 (weekly), 2026-10 (monthly)
  periodKey      String   @map("period_key")
  /// SENT | FAILED | SKIPPED
  status         String
  recipients     Int      @default(0)
  error          String?
  attempts       Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([subscriptionId, periodKey])
  @@index([companyId, createdAt])
  @@map("report_runs")
}

// ---------------------------------------------------------------------------
// Workshop depth (S16): suppliers, parts & stock, tires, warranty
// ---------------------------------------------------------------------------

/// Outside garages and parts / tire suppliers.
model Supplier {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  name             String
  /// GARAGE | PARTS | TIRES | OTHER
  kinds            String[]
  phone            String?
  email            String?
  address          String?
  taxId            String?  @map("tax_id")
  paymentTermsDays Int?     @map("payment_terms_days")
  notes            String?
  /// SAP vendor number (later integration).
  externalRef      String?  @map("external_ref")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  workOrders WorkOrder[]

  @@unique([companyId, name])
  @@map("suppliers")
}

model Part {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  partNo         String   @map("part_no")
  name           String
  category       String?
  unit           String   @default("pcs")
  supplierId     String?  @map("supplier_id") @db.Uuid
  minQty         Decimal  @default(0) @map("min_qty") @db.Decimal(12, 2)
  reorderQty     Decimal  @default(0) @map("reorder_qty") @db.Decimal(12, 2)
  warrantyMonths Int?     @map("warranty_months")
  warrantyKm     Int?     @map("warranty_km")
  /// SAP material number (later integration).
  externalRef    String?  @map("external_ref")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  stocks    PartStock[]
  movements StockMovement[]
  lines     WorkOrderLine[]

  @@unique([companyId, partNo])
  @@map("parts")
}

/// Stock of a part in a branch store (moving average cost).
model PartStock {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  partId    String    @map("part_id") @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  qtyOnHand Decimal   @default(0) @map("qty_on_hand") @db.Decimal(12, 2)
  avgCost   Decimal   @default(0) @map("avg_cost") @db.Decimal(14, 4)
  /// Overrides the part's minimum in this store.
  minQty    Decimal?  @map("min_qty") @db.Decimal(12, 2)
  bin       String?
  alertedAt DateTime? @map("alerted_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  part Part @relation(fields: [partId], references: [id])

  @@unique([partId, branchId])
  @@index([companyId, branchId])
  @@map("part_stocks")
}

model StockMovement {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  partId      String   @map("part_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  /// RECEIPT | ISSUE | RETURN | ADJUST | TRANSFER_OUT | TRANSFER_IN
  kind        String
  /// Signed: + into the store, - out of it.
  qty         Decimal  @db.Decimal(12, 2)
  unitCost    Decimal  @map("unit_cost") @db.Decimal(14, 4)
  value       Decimal  @db.Decimal(14, 2)
  qtyAfter    Decimal  @map("qty_after") @db.Decimal(12, 2)
  workOrderId String?  @map("work_order_id") @db.Uuid
  lineId      String?  @map("line_id") @db.Uuid
  supplierId  String?  @map("supplier_id") @db.Uuid
  reference   String?
  reason      String?
  fileId      String?  @map("file_id") @db.Uuid
  createdBy   String?  @map("created_by") @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at")

  part Part @relation(fields: [partId], references: [id])

  @@index([companyId, occurredAt])
  @@index([partId, branchId, occurredAt])
  @@map("stock_movements")
}

/// Tire fitted at a vehicle position (no individual tire history).
model TireChange {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  vehicleId      String   @map("vehicle_id") @db.Uuid
  position       String
  changedAt      DateTime @map("changed_at")
  odometerKm     Decimal  @map("odometer_km") @db.Decimal(12, 1)
  /// NEW_FIT | WORN | PUNCTURE | DAMAGE | ROTATION | OTHER
  reason         String
  /// ROTATION: the position the tire came from (its km continue).
  fromPosition   String?  @map("from_position")
  brand          String?
  model          String?
  size           String?
  /// NEW | RETREAD | USED
  condition      String   @default("NEW")
  cost           Decimal  @default(0) @db.Decimal(14, 2)
  supplierId     String?  @map("supplier_id") @db.Uuid
  workOrderId    String?  @map("work_order_id") @db.Uuid
  /// Tread of the tire taken off (mm).
  removedTreadMm Decimal? @map("removed_tread_mm") @db.Decimal(5, 1)
  warrantyMonths Int?     @map("warranty_months")
  warrantyKm     Int?     @map("warranty_km")
  notes          String?
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, position, changedAt])
  @@index([companyId, changedAt])
  @@map("tire_changes")
}

model TireCheck {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  vehicleId    String   @map("vehicle_id") @db.Uuid
  position     String
  checkedAt    DateTime @map("checked_at")
  odometerKm   Decimal? @map("odometer_km") @db.Decimal(12, 1)
  treadMm      Decimal? @map("tread_mm") @db.Decimal(5, 1)
  pressure     Decimal? @db.Decimal(6, 1)
  /// WEB | INSPECTION
  source       String   @default("WEB")
  inspectionId String?  @map("inspection_id") @db.Uuid
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, position, checkedAt])
  @@map("tire_checks")
}

model VehicleWarranty {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  vehicleId  String    @map("vehicle_id") @db.Uuid
  /// WHOLE_VEHICLE | ENGINE | GEARBOX | BATTERY | BODY | OTHER
  component  String
  label      String?
  supplierId String?   @map("supplier_id") @db.Uuid
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  endKm      Decimal?  @map("end_km") @db.Decimal(12, 1)
  terms      String?
  fileId     String?   @map("file_id") @db.Uuid
  alertedAt  DateTime? @map("alerted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([companyId, vehicleId])
  @@map("vehicle_warranties")
}

model WarrantyClaim {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  claimNo         String    @map("claim_no")
  vehicleId       String    @map("vehicle_id") @db.Uuid
  workOrderId     String?   @map("work_order_id") @db.Uuid
  supplierId      String?   @map("supplier_id") @db.Uuid
  /// VEHICLE | PART | TIRE
  basis           String
  /// vehicle_warranties.id, work_order_lines.id or tire_changes.id
  basisRef        String?   @map("basis_ref") @db.Uuid
  description     String
  /// DRAFT | SUBMITTED | APPROVED | REJECTED | RECOVERED
  status          String    @default("DRAFT")
  amountClaimed   Decimal   @default(0) @map("amount_claimed") @db.Decimal(14, 2)
  amountApproved  Decimal?  @map("amount_approved") @db.Decimal(14, 2)
  amountRecovered Decimal?  @map("amount_recovered") @db.Decimal(14, 2)
  submittedAt     DateTime? @map("submitted_at")
  decidedAt       DateTime? @map("decided_at")
  recoveredAt     DateTime? @map("recovered_at")
  notes           String?
  fileIds         String[]  @map("file_ids") @db.Uuid
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([companyId, claimNo])
  @@index([companyId, status])
  @@map("warranty_claims")
}
