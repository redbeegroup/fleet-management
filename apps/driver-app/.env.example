# Copy to .env (read by `expo start` / EAS builds)
# Android emulator → host machine running the Docker test stack:
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api
# Physical phone on the same Wi-Fi: use your computer's LAN IP, e.g. http://192.168.1.20:8080/api
# Production: https://fms.example.com/api
EAS_PROJECT_ID=
