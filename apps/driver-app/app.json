{
  "expo": {
    "name": "FMS Driver",
    "slug": "fms-driver",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.fms.driver",
      "permissions": [
        "CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.fms.driver",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of fuel receipts and vehicle problems."
      }
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:8080/api",
      "eas": {
        "projectId": ""
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take photos of fuel receipts and vehicle problems."
        }
      ],
      "expo-notifications",
      "expo-asset"
    ]
  }
}
