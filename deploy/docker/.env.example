# Copy to deploy/docker/.env and adjust. Used by docker-compose.yml (test environment).
COMPOSE_PROJECT_NAME=fms

# Database (test DB runs inside Docker)
POSTGRES_DB=fms
POSTGRES_USER=fms_owner
POSTGRES_PASSWORD=change-me-owner
FMS_APP_PASSWORD=change-me-app

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14

# Seed (demo data + admin user, applied by the migrate service)
SEED=true
SEED_ADMIN_EMAIL=admin@fms.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Telematics: "mock" simulates vehicles; "watchtower" uses the Watch Tower API
TELEMATICS_PROVIDER=mock
WATCHTOWER_BASE_URL=
WATCHTOWER_API_KEY=
WATCHTOWER_POLL_SECONDS=30

# Host ports
WEB_PORT=8080
POSTGRES_PORT=5432
